{
  "format_version": "1.8.0",
  "animations": {
    "animation.horror_kids.light_saver.fly": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            "math.sin(query.life_time * 160) * 0.8",
            0
          ],
          "rotation": [
            "query.is_charging ? 25 : 8",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "math.clamp(query.target_x_rotation, -35, 35)",
            "math.clamp(query.target_y_rotation, -50, 50)",
            0
          ]
        },
        "rightarm": {
          "rotation": [
            "query.is_charging ? -65 : -15 + math.sin(query.life_time * 130) * 6",
            0,
            15
          ]
        },
        "leftarm": {
          "rotation": [
            "query.is_charging ? -65 : -15 - math.sin(query.life_time * 130) * 6",
            0,
            -15
          ]
        },
        "rightleg": {
          "rotation": [
            "20 + math.sin(query.life_time * 150) * 10",
            0,
            5
          ]
        },
        "leftleg": {
          "rotation": [
            "20 - math.sin(query.life_time * 150) * 10",
            0,
            -5
          ]
        }
      }
    }
  }
}
